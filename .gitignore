# macOS
.DS_Store
.AppleDouble
.LSOverride

# Environment and secrets
.env
.env.*
!.env.example

# Common build and dependency dirs (adjust per stack as the project grows)
node_modules/
.gds-src/
dist/
build/
out/
*.tsbuildinfo
target/
__pycache__/
*.py[cod]
.venv/
venv/

# Logs and caches
*.log
.cache/
.turbo/

# IDE
.idea/
.vscode/*
!.vscode/extensions.json

# Vercel — local link (projectId/orgId); do not commit secrets
.vercel/

# macOS DMG staging (artifacts under packaging/macos/out/ use root `out/` ignore)
packaging/macos/.staging/
# Web-hosted DMGs — ship via GitHub Releases, not git blobs (GitHub 100 MB limit)
apps/web/public/downloads/*.dmg

# Local ingest SQLite (default IMPACT_INGEST_DB_PATH)
/data/
